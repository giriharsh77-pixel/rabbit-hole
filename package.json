{
  "name": "rabbit-hole",
  "version": "1.0.0",
  "private": true,
  "description": "Rabbit Hole — see what the internet is talking about, and go deeper. A Chrome (Manifest V3) extension.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --mode development",
    "dev:ui": "vite --config vite.preview.config.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:only": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "server:dev": "tsx server/src/node.ts",
    "verify": "npm run typecheck && node scripts/build.mjs && vitest run && node scripts/verify-release.mjs",
    "seeds:verify": "node scripts/verify-seeds.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "docs:screens": "node docs/source/capture-screens.mjs",
    "docs:flow": "node docs/source/make-flowcharts.mjs",
    "docs:report": "node docs/source/make-report.mjs",
    "docs:form": "python3 docs/source/make-form.py"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
