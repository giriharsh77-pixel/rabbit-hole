# ─────────────────────────────────────────────────────────────────────────────
# Rabbit Hole — build-time configuration
#
# Copy to `.env` (git-ignored) and edit.  Everything here is OPTIONAL: with no
# values at all the extension still works (Reddit via public endpoints/feeds,
# Substack via the built-in publication feeds, topic extraction on-device).
#
# SECURITY: every `VITE_*` variable is compiled into the extension bundle and is
# therefore readable by anyone who installs it.  NEVER put a real secret in a
# production build.  Secrets belong in the backend (see server/README.md) or in
# the extension's Settings page, where they are stored locally in
# chrome.storage.local and are only ever read by the background service worker.
# ─────────────────────────────────────────────────────────────────────────────

# URL of your deployed Rabbit Hole backend (Cloudflare Worker / Node server in
# ./server).  When set, search + AI calls are proxied through it so no API key
# ever ships in the extension.  Its origin is added to the manifest's host
# permissions at build time.  Example: https://rabbit-hole-api.yourname.workers.dev
VITE_BACKEND_URL=

# Reddit "installed app" client ID (public identifier, not a secret).
# Create one at https://www.reddit.com/prefs/apps → type "installed app".
# Enables Reddit's official OAuth API (higher, documented rate limits).
VITE_REDDIT_CLIENT_ID=

# Claude model for the optional AI layer.  Defaults to claude-opus-5-5; pick a
# smaller/cheaper model (e.g. claude-haiku-4-5) to cut cost and latency.
VITE_AI_MODEL=

# ── DEVELOPMENT-ONLY KEYS ────────────────────────────────────────────────────
# These are embedded ONLY when building with `npm run dev` (mode=development).
# They are stripped from `npm run build`.  Use throwaway keys.
# Brave Search API key (https://brave.com/search/api/) — Substack discovery.
VITE_DEV_BRAVE_API_KEY=
# Anthropic API key (https://console.anthropic.com/) — optional AI layer.
VITE_DEV_ANTHROPIC_API_KEY=
